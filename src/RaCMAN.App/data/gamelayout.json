// Game panel layout, owned by the client.
//
// Two lists say where a section is drawn:
//   "subPages"    sections that become a page of their own, indented under Game in the side nav
//                 (the less-used controls).
//   "unlocksTabs" sections the Unlocks panel draws as tabs of its own, beside its Weapons/Gadgets
//                 category tabs, for the ones that belong with the unlock table.
// Every section in neither list stacks on the Game page, always visible. A section named in both
// stays a sub-page, and a game with no unlock table has no Unlocks entry in the nav at all, so for
// that game the tabs are listed under Game instead and nothing goes missing.
// ("sideSections", the older spelling of "subPages", still works.)
//
// "games" is keyed by game: "rac1", "rac2", "rac3", "rac4". An entry keyed by a title id is
// honoured first, for a release that needs its own layout; the game key is what BCES01503 needs,
// since that one disc hosts RaC1, RaC2 and RaC3.
//
// "moves" sends a feature (by its exact DESCRIBE label) to a named section, creating it if needed.
// Anything not moved stays in its qwark DESCRIBE group, and VALUE features default to the editable
// table at the top of the Game page (the "Values" section). A group everything is moved out of
// simply stops appearing.
// "tabOrder" sets the section order; sections used but not listed follow in first-seen order.
//
// "headings" breaks a section up: it is keyed by section name, then by the heading text, and each
// heading lists the feature labels (again, the exact DESCRIBE ones) it is drawn in front of. The
// features a heading names are collected under it in their own order, and the ones no heading names
// stay where they were. A section nothing lists is drawn exactly as before.
//
// Four section names are reserved, because a panel decides where each of them is drawn. None of
// them can be a sub-page, a stacked header or a tab-order entry:
//   "Quick"   the block at the very top of the Game page: die, the position pair, the savefile
//             actions, and the slot and planet controls. A feature moved here is drawn with them.
//   "Values"  the editable table under the quick block (where a VALUE goes by default).
//   "Options" the column beside that table, for the few in-game switches that belong to the save
//             file rather than to a run (UYA's quick-select pause, RaC1's goodies menu).
//   "Unlocks" not drawn on the Game page at all; the Unlocks panel draws these as buttons above
//             its table, for actions that rewrite the whole unlock list.
// "Player" is an ordinary section. The quick block draws the two ACTIONs qwark flags SAVE_ASIDE and
// LOAD_ASIDE and an ACTION labelled "Die" itself, wherever they are moved to, so a section left
// with nothing but those is not drawn at all.
//
// Edit freely; the app reads this on start.
{
  "subPages": ["Manips", "Cosmetics", "Debug"],
  "unlocksTabs": ["Collectables"],

  "games": {
    "rac1": {
      "tabOrder": ["Cheats", "Player", "Savefile", "Manips", "Collectables", "Cosmetics", "Debug"],
      "moves": {
        "Goodies menu": "Options",

        "Drek skip": "Manips",
        "Drek cutscene": "Manips",
        "Any% all-missions reset": "Manips",
        "Setup shooting skill points": "Manips",
        "Reset shooting skill points": "Manips",

        "Unlock all gold bolts": "Collectables",
        "Reset all gold bolts": "Collectables",
        "Unlock all skill points": "Collectables",
        "Reset skill points": "Collectables",

        "Jankpot bolts": "Debug",
        "Jankpot timer (frames)": "Debug",
        "Activate jankpot": "Debug"
      }
    },

    "rac2": {
      "tabOrder": ["Cheats", "Player", "Savefile", "Manips", "Collectables", "Cosmetics", "Debug"],
      "moves": {
        "Reset any% manips": "Manips",
        "Reset NG+ manips/menus": "Manips",
        "NG+ setup": "Manips",
        "NG+ No IMG setup": "Manips",
        "NG+ All Missions setup": "Manips",
        "Maktar slots": "Manips",
        "Auto-reset (any%)": "Manips",
        "Auto-reset (NG+)": "Manips",
        "Max all weapon levels": "Unlocks",
        "Max all weapon ammo": "Unlocks",

        "Enable debug mode": "Debug",
        "QE save write-offset": "Debug"
      }
    },

    "rac3": {
      "tabOrder": ["Cheats", "Player", "Savefile", "Manips", "Collectables", "Cosmetics", "Debug"],
      "moves": {
        "Quick-select pause": "Options",

        "Setup NG+ manips": "Manips",
        "CC early setup": "Manips",
        "Untune bosses": "Manips",
        "Reset dropship health": "Manips",

        "Refresh trophy state": "Savefile",

        "Unlock all skill points": "Collectables",
        "Reset all skill points": "Collectables",
        "Unlock all titanium bolts": "Collectables",
        "Reset all titanium bolts": "Collectables",

        "Max all weapon levels": "Unlocks",
        "Reset all weapon levels": "Unlocks",

        "Armour": "Cosmetics",
        "Ship colour": "Cosmetics",

        "QE offset": "Debug",
        "Enable vendor QE": "Debug"
      },
      "headings": {
        "Cosmetics": {
          "Chargeboots": [
            "Chargeboots primary front",
            "Chargeboots primary back",
            "Chargeboots tint"
          ]
        }
      }
    },

    "rac4": {
      "tabOrder": ["Cheats", "Player", "Savefile", "Manips", "Collectables", "Cosmetics", "Debug"],
      "moves": {
        "Unlock all planets": "Player",
        "Act tune bosses": "Manips",

        "Max all weapon levels": "Unlocks",
        "Max all weapon ammo": "Unlocks",

        "Skin": "Cosmetics"
      }
    }
  }
}
